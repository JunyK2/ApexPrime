# ApexPrime Redmi 6A — copy to the repository root as .env and chmod 600.
# Server-side secrets ONLY. Never commit .env or paste these values in the PWA.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
GEMINI_API_KEY=YOUR_GEMINI_KEY
GROQ_API_KEY=YOUR_GROQ_KEY
CHART_IMG_API_KEY=YOUR_CHART_IMG_KEY
TELEGRAM_BOT_TOKEN=YOUR_NEW_TELEGRAM_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHANNEL_ID

# Binance USDⓈ-M Futures public market-data endpoints; no API key required.
BINANCE_FAPI_BASE=https://fapi.binance.com
CHART_IMG_SYMBOL=BINANCE:BTCUSDT.P

# Paper trading is mandatory in this build.
PAPER_TRADING_ONLY=true
APEX_REAL_TRADING_ENABLED=false

# Reserved fields for a future review. Do not put real credentials here now.
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=

# Redmi 6A identity and schedule.
APEX_DEVICE_ID=redmi6a-main
APEX_DEVICE_NAME=Redmi 6A
DEVICE_HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_TELEMETRY_INTERVAL_SECONDS=300
DEVICE_OFFLINE_AFTER_SECONDS=180
MAINTENANCE_INTERVAL_SECONDS=60
MARKET_SCAN_INTERVAL_SECONDS=900
QUEUE_POLL_INTERVAL_SECONDS=30
DEVICE_LOW_BATTERY_THRESHOLD=40
DEVICE_BATTERY_REARM_THRESHOLD=45
DEVICE_STATE_PATH=runtime/device_state.sqlite3
LOG_LEVEL=INFO
